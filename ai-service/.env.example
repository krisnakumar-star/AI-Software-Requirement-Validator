# Copy to .env locally. Never commit real values.
# Internal key shared ONLY between Spring Boot (LLM_API_KEY) and this service.
# It is not an AI-provider key; no external AI service is used.
SRS_API_KEY=

# Optional limits
MAX_BATCH_REQUIREMENTS=500
MAX_REQUIREMENT_CHARS=5000

# Optional local semantic model (see setup_models.py). Leave empty for the lightweight TF-IDF mode.
SRS_SEMANTIC_MODEL=
