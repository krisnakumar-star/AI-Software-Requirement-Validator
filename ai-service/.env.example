# Internal key shared only between Spring Boot (LLM_API_KEY) and this FastAPI service.
SRS_API_KEY=

# Groq API key. Create it in the Groq Console and keep it private.
GROQ_API_KEY=

# Groq OpenAI-compatible endpoint and model.
LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=openai/gpt-oss-120b
